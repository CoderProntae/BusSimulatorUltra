; Bus Simulator Ultra
config_version=5

[application]
config/name="BusSimulator"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]

[display/window]
size/viewport_width=1280
size/viewport_height=720
size/window_width_override=1280
size/window_height_override=720
stretch/mode="canvas_items"
handheld/orientation=1

[rendering]
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
common/physics_ticks_per_second=60

[input]
accelerate={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
brake={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
steer_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
steer_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
door={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
camera={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":67)]}
headlights={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":76)]}
